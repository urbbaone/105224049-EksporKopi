// prisma/schema.prisma
// Model untuk platform ekspor kopi: Shipment (Induk) & Document (Anak)
// Prisma 7 + PostgreSQL

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────
// Entitas Induk (Parent): Pengiriman Ekspor Kopi (Shipment)
// ─────────────────────────────────────────────────────────
model Shipment {
  id             String     @id @default(cuid())
  trackingNumber String     @unique               // Nomor resi/BL: misal EXP-2026-001
  destination    String                           // Negara/Kota tujuan (misal: Hamburg, Germany)
  totalKg        Float      @default(0)           // Berat muatan kopi dalam Kilogram (> 0)
  status         String     @default("PENDING")   // PENDING | IN_TRANSIT | DELIVERED
  description    String?                          // Catatan instruksi pengiriman
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relasi One-to-Many ke Dokumen Legalitas Ekspor
  documents      Document[]

  @@map("shipments")
}

// ─────────────────────────────────────────────────────────
// Entitas Anak (Child): Dokumen Legalitas Ekspor (Document)
// ─────────────────────────────────────────────────────────
model Document {
  id             String     @id @default(cuid())
  title          String                           // Judul dokumen (min 3 karakter)
  type           String                           // Phytosanitary | Certificate of Origin | Commercial Invoice
  fee            Float      @default(0)           // Biaya legalisasi dokumen (> 0)
  status         String     @default("PENDING")   // PENDING | VERIFIED | REJECTED
  notes          String?                          // Catatan tambahan
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Foreign Key & Relasi ke Entitas Induk (Shipment)
  shipmentId     String
  shipment       Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("documents")
}
